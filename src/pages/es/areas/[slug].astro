---
import { getCollection, type CollectionEntry } from 'astro:content';
import AreaDetailPage from '@/components/pages/AreaDetailPage.astro';

export async function getStaticPaths() {
  const areas = await getCollection('areas_es');
  return areas.map((area: CollectionEntry<'areas_es'>) => ({
    params: { slug: area.id },
    props: { area },
  }));
}

const { area } = Astro.props;
---

<AreaDetailPage locale="es" area={area} />
