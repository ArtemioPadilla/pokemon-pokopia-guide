---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/common/SectionHead.astro';
import { getLocalized } from '@/lib/content';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const recipes = (await getLocalized('recipes', locale)).sort((a, b) => a.data.order - b.data.order);
const categories = [...new Set(recipes.map((r) => r.data.category))];
type RecipeMaterial = (typeof recipes)[number]['data']['materials'][number];
const categoryLabelKey = {
  furniture: 'recipes.cat.furniture',
  buildings: 'recipes.cat.buildings',
  utilities: 'recipes.cat.utilities',
  outdoor: 'recipes.cat.outdoor',
  blocks: 'recipes.cat.blocks',
  misc: 'recipes.cat.misc',
} as const;
---

<BaseLayout title={`${t('recipes.title')} · ${t('site.name')}`} lang={locale}>
  <main id="main" class="mx-auto max-w-4xl px-5 py-14">
    <SectionHead level="h1" title={t('recipes.title')} tight />
    <p class="mb-6 text-sm text-muted-foreground">{t('recipes.note')}</p>
    {
      categories.map((cat) => (
        <section class="mb-8">
          <h2 class="mb-2 font-display text-sm font-semibold tracking-wide text-muted-foreground">
            {t(categoryLabelKey[cat as keyof typeof categoryLabelKey])}
          </h2>
          <div class="ledger overflow-x-auto">
            <table class="w-full min-w-[480px] border-collapse text-sm">
              <thead>
                <tr class="border-b border-border text-left font-mono text-xs uppercase tracking-wide text-muted-foreground">
                  <th class="px-3 py-2.5">{locale === 'en' ? 'Recipe' : 'Receta'}</th>
                  <th class="px-3 py-2.5">{t('recipes.materials')}</th>
                  <th class="px-3 py-2.5">{t('recipes.unlock')}</th>
                </tr>
              </thead>
              <tbody>
                {recipes
                  .filter((r) => r.data.category === cat)
                  .map((r) => {
                    const maxQty = Math.max(
                      ...r.data.materials.map((m: RecipeMaterial) => m.quantity),
                    );
                    return (
                      <tr class="border-b border-border/60 last:border-0">
                        <td class="px-3 py-2.5 font-medium text-foreground">{r.data.name}</td>
                        <td class="px-3 py-2.5">
                          <div class="flex flex-col gap-1">
                            {r.data.materials.map((m: RecipeMaterial) => (
                              <div class="flex items-center gap-2">
                                <span class="w-6 shrink-0 text-right font-mono text-[11px] text-primary">
                                  {m.quantity}×
                                </span>
                                <span class="min-w-0 flex-1 truncate text-muted-foreground">
                                  {m.name}
                                </span>
                                <span
                                  class="h-1.5 w-14 shrink-0 overflow-hidden rounded-full bg-muted"
                                  role="img"
                                  aria-label={`${m.quantity} of ${maxQty} — relative amount of ${m.name} in this recipe`}
                                >
                                  <span
                                    class="block h-full rounded-full bg-primary/70"
                                    style={`width: ${Math.max(18, Math.round((m.quantity / maxQty) * 100))}%`}
                                  />
                                </span>
                              </div>
                            ))}
                          </div>
                        </td>
                        <td class="px-3 py-2.5 text-muted-foreground">{r.data.unlockMethod}</td>
                      </tr>
                    );
                  })}
              </tbody>
            </table>
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>
